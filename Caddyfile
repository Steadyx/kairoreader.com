{
	email {$ACME_EMAIL}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	root * /srv
	encode zstd gzip

	@slashlessPages path /rsvp-reading-app /android-rsvp-reader /epub-speed-reading-app /orp-highlighting /calm-speed-reading-app /mobi-epub-reader-android /privacy-policy
	redir @slashlessPages {http.request.uri.path}/ permanent

	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
