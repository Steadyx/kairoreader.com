{
  "name": "kairoreader.com",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "type": "module",
  "scripts": {
    "up": "node scripts/kairo.mjs dev",
    "stop": "node scripts/kairo.mjs stop",
    "status": "node scripts/kairo.mjs status",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.prerender.config.ts && node scripts/prerender.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:seo": "node scripts/audit-seo.mjs",
    "deploy:check": "npm run typecheck && npm run audit:dependencies && npm run build && npm run audit:seo",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/static-server.mjs",
    "container:build": "node scripts/kairo.mjs container-build",
    "container:run": "node scripts/kairo.mjs container-up",
    "container:up": "node scripts/kairo.mjs container-up",
    "container:stop": "node scripts/kairo.mjs container-stop",
    "container:down": "node scripts/kairo.mjs container-stop"
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  }
}
